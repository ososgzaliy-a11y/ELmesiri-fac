# =========================================================================
# Al-Mesiri E-Commerce - Environment Configuration Template
# =========================================================================

# Server Configuration
PORT=8000
NODE_ENV=development
BASE_URL=http://localhost:8000

# Public Webhook URL (For Local Testing with Ngrok / LocalTunnel)
WEBHOOK_PUBLIC_URL=http://localhost:8000

# =========================================================================
# XPay Payment Gateway Credentials
# =========================================================================
XPAY_PUBLISHABLE_KEY=your_xpay_publishable_key_here
XPAY_SECRET_KEY=your_xpay_secret_key_here
XPAY_BASE_URL=https://staging.xpay.app/api/v1
XPAY_CALLBACK_URL=http://localhost:8000/store.html?payment_status=success&gateway=xpay
